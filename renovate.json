{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":dependencyDashboard",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Node stays on 24 until 26 is tested. This covers the node image, node-version in setup-node (looked up as actions/node-versions), .nvmrc, engines and @types/node.",
      "matchPackageNames": [
        "node",
        "actions/node-versions",
        "@types/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "The node image and .nvmrc move together, since the release builds the client manifest with .nvmrc and the image has to produce the same bytes",
      "matchPackageNames": [
        "node"
      ],
      "matchManagers": [
        "dockerfile",
        "nvm"
      ],
      "groupName": "Node"
    },
    {
      "description": "Group Mantine packages, they must move together",
      "matchPackageNames": [
        "@mantine/core",
        "@mantine/hooks",
        "@mantine/dropzone",
        "@mantine/notifications"
      ],
      "groupName": "Mantine"
    },
    {
      "description": "Group the GlimStone packages, a lone core bump leaves a second core nested under vue",
      "matchPackageNames": [
        "@glimstone/core",
        "@glimstone/vue"
      ],
      "groupName": "GlimStone"
    },
    {
      "description": "Group tus packages",
      "matchPackageNames": [
        "tus-js-client"
      ],
      "groupName": "tus"
    },
    {
      "description": "Auto-merge minor/patch for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Docker: auto-merge digest pins and digest refreshes (same tag, new build). Major/minor stay open for review.",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "commitMessagePrefix": "ci:",
      "labels": [
        "docker"
      ]
    },
    {
      "description": "The compose file is for people to copy, so it follows the app's own latest tag instead of a digest that goes stale every build",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "junkerderprovinz/castleparcel"
      ],
      "enabled": false
    }
  ]
}
